rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 OWNER ADMIN RULE (MANOJ KUMAR SHARMA ONLY)
    function isOwnerAdmin() {
      return request.auth != null && (
        request.auth.token.email == "passportphoto2026@gmail.com" ||
        request.auth.token.email == "manoj.watkar61@gmail.com" ||
        request.auth.token.email == "monusharma847224@gmail.com"
      );
    }

    // 🔒 APPROVED UNLIMITED USERS (CLOUD REGISTRY)
    match /approved_users/{docId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // 🔒 USER PROFILES & CREDITS
    match /users/{userId} {
      // Users can read their own data, or Owner Admin can manage
      allow read: if request.auth != null && (request.auth.uid == userId || isOwnerAdmin());
      allow create: if request.auth != null && (request.auth.uid == userId || isOwnerAdmin())
                    && (!('isUnlimited' in request.resource.data) || request.resource.data.isUnlimited == false || isOwnerAdmin())
                    && (!('credits' in request.resource.data) || request.resource.data.credits <= 5 || isOwnerAdmin());
      allow update: if isOwnerAdmin() || (
        request.auth != null && request.auth.uid == userId
        // A regular user cannot upgrade themselves to unlimited or alter plan
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isUnlimited', 'plan', 'planExpires']))
        // A regular user can only spend credits (decrement), NEVER increase them!
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']) || request.resource.data.credits <= resource.data.credits)
      );
      allow delete: if isOwnerAdmin();
    }

    // 🔒 PAYMENT TRANSACTIONS & RECHARGES
    match /transactions/{txnId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isOwnerAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isOwnerAdmin();
    }

    // 🔒 PAYMENT REQUESTS (UTR APPROVALS & VERIFICATION)
    match /payment_requests/{reqId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwnerAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isOwnerAdmin();
    }
  }
}
